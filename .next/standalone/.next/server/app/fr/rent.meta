{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/(code)/layout,_N_T_/[locale]/(code)/rent/layout,_N_T_/[locale]/(code)/rent/page,_N_T_/fr/rent"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale",
    "/$d$locale/!KGNvZGUp/rent/__PAGE__"
  ],
  "prefetchHints": {
    "hints": 64,
    "slots": {
      "children": {
        "hints": 32,
        "slots": {
          "children": {
            "hints": 64,
            "slots": {
              "children": {
                "hints": 96,
                "slots": {
                  "children": {
                    "hints": 160,
                    "slots": null
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}